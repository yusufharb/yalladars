# ============================================================================
# YallaDars Environment Configuration
# ============================================================================

# --- Supabase PostgreSQL Database (Production Cloud Database) ---
# Obtain from Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
# Optional: SUPABASE_ANON_KEY (can be used if service role is omitted)
SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Security & JWT Authentication ---
# Generate a secure 64-char random hex string (e.g. using `openssl rand -hex 32`)
JWT_SECRET="generate-a-secure-random-secret-key-at-least-32-chars-long"

# --- Google Gemini AI API ---
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# --- Server & Deployment Configuration (Railway / Render / VPS) ---
NODE_ENV="production"
PORT=3000
APP_URL="https://your-app-name.up.railway.app"
